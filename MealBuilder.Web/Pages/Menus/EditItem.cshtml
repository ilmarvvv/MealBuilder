@page "{id:int}"
@model MealBuilder.Web.Pages.Menus.EditItemModel

@{
    ViewData["Title"] = "Edit Menu Item";
}

<h1>Edit Menu Item</h1>

<h2>@Model.ItemName</h2>

<form method="post">
    <input type="hidden" asp-for="MenuItem.Id" />
    <input type="hidden" asp-for="MenuItem.MenuId" />
    <input type="hidden" asp-for="MenuItem.ItemType" />
    <input type="hidden" asp-for="MenuItem.RecipeId" />
    <input type="hidden" asp-for="MenuItem.IngredientId" />

    @if (Model.MenuItem.ItemType == MealBuilder.Web.Models.MenuItemType.Recipe)
    {
        <div class="mb-3">
            <label asp-for="MenuItem.ServingsCount" class="form-label">Servings</label>
            <input asp-for="MenuItem.ServingsCount" class="form-control" />
            <span asp-validation-for="MenuItem.ServingsCount" class="text-danger"></span>
        </div>
    }
    else if (Model.MenuItem.ItemType == MealBuilder.Web.Models.MenuItemType.Ingredient)
    {
        <div class="mb-3">
            <label asp-for="MenuItem.Grams" class="form-label"></label>
            <input asp-for="MenuItem.Grams" class="form-control" />
            <span asp-validation-for="MenuItem.Grams" class="text-danger"></span>
        </div>
    }

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="./Details" asp-route-id="@Model.MenuItem.MenuId" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}