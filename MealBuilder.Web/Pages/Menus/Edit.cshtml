@page "{id:int}"
@model MealBuilder.Web.Pages.Menus.EditModel

@{
    ViewData["Title"] = "Edit Menu";
}

<h1>Edit Menu</h1>

<form method="post">
    <input type="hidden" asp-for="Menu.Id" />

    <div class="mb-3">
        <label asp-for="Menu.Name" class="form-label"></label>
        <input asp-for="Menu.Name" class="form-control" />
        <span asp-validation-for="Menu.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Menu.Date" class="form-label"></label>
        <input asp-for="Menu.Date" class="form-control" type="date" />
        <span asp-validation-for="Menu.Date" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Menu.Description" class="form-label"></label>
        <textarea asp-for="Menu.Description" class="form-control"></textarea>
        <span asp-validation-for="Menu.Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="./Details" asp-route-id="@Model.Menu.Id" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}