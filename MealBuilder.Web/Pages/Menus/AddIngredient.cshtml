@page "{id:int}"
@model MealBuilder.Web.Pages.Menus.AddIngredientModel

@{
    ViewData["Title"] = "Add Ingredient to Menu";
}

<h1>Add Ingredient to Menu</h1>

<h2>@Model.Menu.Name - @Model.Menu.Date</h2>

<form method="post">
    <input type="hidden" asp-for="MenuItem.MenuId" />
    <input type="hidden" asp-for="MenuItem.ItemType" />

    <div class="mb-3">
        <label asp-for="MenuItem.IngredientId" class="form-label">Ingredient</label>
        <select asp-for="MenuItem.IngredientId" asp-items="Model.Ingredients" class="form-control">
            <option value="">Select ingredient</option>
        </select>
        <span asp-validation-for="MenuItem.IngredientId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MenuItem.Grams" class="form-label"></label>
        <input asp-for="MenuItem.Grams" class="form-control" />
        <span asp-validation-for="MenuItem.Grams" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Add</button>
    <a asp-page="./Details" asp-route-id="@Model.Menu.Id" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}