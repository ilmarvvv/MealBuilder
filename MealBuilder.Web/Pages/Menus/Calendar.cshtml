@page
@model MealBuilder.Web.Pages.Menus.CalendarModel

@{
    ViewData["Title"] = "Menu Calendar";
}

<h1>Menu Calendar</h1>

<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Menu</th>
            <th>Calories</th>
            <th>Protein</th>
            <th>Fiber</th>
            <th>Sugar</th>
            <th>Salt</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var day in Model.Days)
        {
            <tr>
                <td>@day.Date</td>
                <td>
                    @if (day.Menu is null)
                    {
                        <span>No menu</span>
                    }
                    else
                    {
                        <a asp-page="./Details" asp-route-id="@day.Menu.Id">@day.Menu.Name</a>
                    }
                </td>
                <td>@day.Totals.Calories.ToString("0.00")</td>
                <td>@day.Totals.Protein.ToString("0.00")</td>
                <td>@day.Totals.Fiber.ToString("0.00")</td>
                <td>@day.Totals.Sugar.ToString("0.00")</td>
                <td>@day.Totals.Salt.ToString("0.00")</td>
            </tr>
        }
    </tbody>
</table>