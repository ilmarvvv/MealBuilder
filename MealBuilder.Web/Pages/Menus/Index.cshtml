@page
@model MealBuilder.Web.Pages.Menus.IndexModel

@{
    ViewData["Title"] = "Menus";
}

<h1>Menus</h1>

<p>
    <a asp-page="./Create" class="btn btn-primary">Create Menu</a>
</p>

@if (Model.Menus.Count == 0)
{
    <p>No menus have been added yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Name</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var menu in Model.Menus)
            {
                <tr>
                    <td>@menu.Date</td>
                    <td>@menu.Name</td>
                    <td>@menu.Description</td>
                </tr>
            }
        </tbody>
    </table>
}