@page "{id:int}"
@model MealBuilder.Web.Pages.Menus.DetailsModel

@{
    ViewData["Title"] = "Menu Details";
}

<h1>Menu Details</h1>

<dl class="row">
    <dt class="col-sm-2">Date</dt>
    <dd class="col-sm-10">@Model.Menu.Date</dd>

    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Menu.Name</dd>

    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Menu.Description</dd>
</dl>

<h2>Totals</h2>

<table class="table">
    <thead>
        <tr>
            <th>Calories</th>
            <th>Protein</th>
            <th>Fiber</th>
            <th>Sugar</th>
            <th>Salt</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@Model.Totals.Calories.ToString("0.00")</td>
            <td>@Model.Totals.Protein.ToString("0.00")</td>
            <td>@Model.Totals.Fiber.ToString("0.00")</td>
            <td>@Model.Totals.Sugar.ToString("0.00")</td>
            <td>@Model.Totals.Salt.ToString("0.00")</td>
        </tr>
    </tbody>
</table>

<h2>Items</h2>

<p>
    <a asp-page="./AddRecipe" asp-route-id="@Model.Menu.Id" class="btn btn-primary">Add Recipe</a>
    <a asp-page="./AddIngredient" asp-route-id="@Model.Menu.Id" class="btn btn-primary">Add Ingredient</a>
    <a asp-page="./AddPreparedBatch" asp-route-id="@Model.Menu.Id" class="btn btn-primary">Add Prepared Batch</a>
</p>

@if (Model.Menu.MenuItems.Count == 0)
{
    <p>No items have been added to this menu yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Type</th>
                <th>Name</th>
                <th>Amount</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var menuItem in Model.Menu.MenuItems)
            {
                <tr>
                    <td>@menuItem.ItemType</td>
                    <td>
                        @if (menuItem.ItemType == MealBuilder.Web.Models.MenuItemType.Recipe)
                        {
                            @menuItem.Recipe?.Name
                        }
                        else if (menuItem.ItemType == MealBuilder.Web.Models.MenuItemType.Ingredient)
                        {
                            @menuItem.Ingredient?.Name
                        }
                        else if (menuItem.ItemType == MealBuilder.Web.Models.MenuItemType.PreparedRecipeBatch)
                        {
                            @($"{menuItem.PreparedRecipeBatch?.Recipe?.Name} | cooked {menuItem.PreparedRecipeBatch?.CookedDate}")
                        }
                    </td>
                    <td>
                        @if (menuItem.ItemType == MealBuilder.Web.Models.MenuItemType.Recipe)
                        {
                            @($"{menuItem.ServingsCount} servings")
                        }
                        else if (menuItem.ItemType == MealBuilder.Web.Models.MenuItemType.Ingredient)
                        {
                            @($"{menuItem.Grams} g")
                        }
                        else if (menuItem.ItemType == MealBuilder.Web.Models.MenuItemType.PreparedRecipeBatch)
                        {
                            @($"{menuItem.ServingsCount} servings")
                        }
                    </td>
                    <td>
                        <a asp-page="./EditItem" asp-route-id="@menuItem.Id">Edit</a>

                        <form method="post" asp-page-handler="RemoveItem" class="d-inline">
                            <input type="hidden" name="menuItemId" value="@menuItem.Id" />
                            <button type="submit" class="btn btn-link p-0">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-page="./Edit" asp-route-id="@Model.Menu.Id" class="btn btn-primary">Edit</a>
<a asp-page="./Delete" asp-route-id="@Model.Menu.Id" class="btn btn-danger">Delete</a>
<a asp-page="./Index" class="btn btn-secondary">Back</a>