@page "{id:int}"
@model MealBuilder.Web.Pages.Menus.DetailsModel

@{
    ViewData["Title"] = "Menu Details";
}

<h1>Menu Details</h1>

<dl class="row">
    <dt class="col-sm-2">Date</dt>
    <dd class="col-sm-10">@Model.Menu.Date</dd>

    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Menu.Name</dd>

    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Menu.Description</dd>
</dl>

<h2>Items</h2>

<p>
    <a asp-page="./AddRecipe" asp-route-id="@Model.Menu.Id" class="btn btn-primary">Add Recipe</a>
    <a asp-page="./AddIngredient" asp-route-id="@Model.Menu.Id" class="btn btn-primary">Add Ingredient</a>
</p>

@if (Model.Menu.MenuItems.Count == 0)
{
    <p>No items have been added to this menu yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Type</th>
                <th>Name</th>
                <th>Amount</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var menuItem in Model.Menu.MenuItems)
            {
                <tr>
                    <td>@menuItem.ItemType</td>
                    <td>
                        @if (menuItem.ItemType == MealBuilder.Web.Models.MenuItemType.Recipe)
                        {
                            @menuItem.Recipe?.Name
                        }
                        else if (menuItem.ItemType == MealBuilder.Web.Models.MenuItemType.Ingredient)
                        {
                            @menuItem.Ingredient?.Name
                        }
                    </td>
                    <td>
                        @if (menuItem.ItemType == MealBuilder.Web.Models.MenuItemType.Recipe)
                        {
                            @($"{menuItem.ServingsCount} servings")
                        }
                        else if (menuItem.ItemType == MealBuilder.Web.Models.MenuItemType.Ingredient)
                        {
                            @($"{menuItem.Grams} g")
                        }
                    </td>
                    <td>
                        <a asp-page="./EditItem" asp-route-id="@menuItem.Id">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-page="./Index" class="btn btn-secondary">Back</a>