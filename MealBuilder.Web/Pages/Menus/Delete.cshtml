@page "{id:int}"
@model MealBuilder.Web.Pages.Menus.DeleteModel

@{
    ViewData["Title"] = "Delete Menu";
}

<h1>Delete Menu</h1>

<p class="text-danger">Are you sure you want to delete this menu?</p>

<dl class="row">
    <dt class="col-sm-3">Date</dt>
    <dd class="col-sm-9">@Model.Menu.Date</dd>

    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Menu.Name</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Menu.Description</dd>
</dl>

<form method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="./Details" asp-route-id="@Model.Menu.Id" class="btn btn-secondary">Cancel</a>
</form>