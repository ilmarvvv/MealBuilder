@page "{id:int}"
@model MealBuilder.Web.Pages.Ingredients.EditModel

@{
    ViewData["Title"] = "Edit Ingredient";
}

<h1>Edit Ingredient</h1>

<form method="post">
    <input type="hidden" asp-for="Ingredient.Id" />

    <div class="mb-3">
        <label asp-for="Ingredient.Name" class="form-label"></label>
        <input asp-for="Ingredient.Name" class="form-control" />
        <span asp-validation-for="Ingredient.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Ingredient.CaloriesPer100g" class="form-label"></label>
        <input asp-for="Ingredient.CaloriesPer100g" class="form-control" />
        <span asp-validation-for="Ingredient.CaloriesPer100g" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Ingredient.ProteinPer100g" class="form-label"></label>
        <input asp-for="Ingredient.ProteinPer100g" class="form-control" />
        <span asp-validation-for="Ingredient.ProteinPer100g" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Ingredient.FiberPer100g" class="form-label"></label>
        <input asp-for="Ingredient.FiberPer100g" class="form-control" />
        <span asp-validation-for="Ingredient.FiberPer100g" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Ingredient.SugarPer100g" class="form-label"></label>
        <input asp-for="Ingredient.SugarPer100g" class="form-control" />
        <span asp-validation-for="Ingredient.SugarPer100g" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Ingredient.SaltPer100g" class="form-label"></label>
        <input asp-for="Ingredient.SaltPer100g" class="form-control" />
        <span asp-validation-for="Ingredient.SaltPer100g" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Ingredient.GramsPerPiece" class="form-label"></label>
        <input asp-for="Ingredient.GramsPerPiece" class="form-control" />
        <span asp-validation-for="Ingredient.GramsPerPiece" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Ingredient.GramsPerMilliliter" class="form-label"></label>
        <input asp-for="Ingredient.GramsPerMilliliter" class="form-control" />
        <span asp-validation-for="Ingredient.GramsPerMilliliter" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Ingredient.Notes" class="form-label"></label>
        <textarea asp-for="Ingredient.Notes" class="form-control"></textarea>
        <span asp-validation-for="Ingredient.Notes" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
