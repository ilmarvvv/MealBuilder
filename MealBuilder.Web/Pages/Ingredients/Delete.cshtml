@page "{id:int}"
@model MealBuilder.Web.Pages.Ingredients.DeleteModel

@{
    ViewData["Title"] = "Delete Ingredient";
}

<h1>Delete Ingredient</h1>

@if (Model.IsUsed)
{
    <p class="text-danger">
        This ingredient cannot be deleted because it is used in recipes or daily plans.
    </p>
}
else
{
    <p class="text-danger">Are you sure you want to delete this ingredient?</p>
}

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Ingredient.Name</dd>

    <dt class="col-sm-3">Calories per 100g</dt>
    <dd class="col-sm-9">@Model.Ingredient.CaloriesPer100g</dd>

    <dt class="col-sm-3">Protein per 100g</dt>
    <dd class="col-sm-9">@Model.Ingredient.ProteinPer100g</dd>

    <dt class="col-sm-3">Fiber per 100g</dt>
    <dd class="col-sm-9">@Model.Ingredient.FiberPer100g</dd>

    <dt class="col-sm-3">Sugar per 100g</dt>
    <dd class="col-sm-9">@Model.Ingredient.SugarPer100g</dd>

    <dt class="col-sm-3">Salt per 100g</dt>
    <dd class="col-sm-9">@Model.Ingredient.SaltPer100g</dd>
</dl>

<form method="post">
    @if (!Model.IsUsed)
    {
        <button type="submit" class="btn btn-danger">Delete</button>
    }

    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
</form>
