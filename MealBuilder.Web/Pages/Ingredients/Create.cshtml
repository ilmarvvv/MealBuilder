@page
@model MealBuilder.Web.Pages.Ingredients.CreateModel

@{
    ViewData["Title"] = "Create Ingredient";
}

<h1>Create Ingredient</h1>

<form method="post">
    <div class="mb-3">
        <label asp-for="Ingredient.Name" class="form-label"></label>
        <input asp-for="Ingredient.Name" class="form-control" />
        <span asp-validation-for="Ingredient.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Ingredient.CaloriesPer100g" class="form-label"></label>
        <input asp-for="Ingredient.CaloriesPer100g" class="form-control" />
        <span asp-validation-for="Ingredient.CaloriesPer100g" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Ingredient.ProteinPer100g" class="form-label"></label>
        <input asp-for="Ingredient.ProteinPer100g" class="form-control" />
        <span asp-validation-for="Ingredient.ProteinPer100g" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Ingredient.FiberPer100g" class="form-label"></label>
        <input asp-for="Ingredient.FiberPer100g" class="form-control" />
        <span asp-validation-for="Ingredient.FiberPer100g" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
