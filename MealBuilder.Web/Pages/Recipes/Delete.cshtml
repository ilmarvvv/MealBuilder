@page "{id:int}"
@model MealBuilder.Web.Pages.Recipes.DeleteModel

@{
    ViewData["Title"] = "Delete Recipe";
}

<h1>Delete Recipe</h1>

<p>Are you sure you want to delete this recipe?</p>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Recipe.Name</dd>

    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Recipe.Description</dd>

    <dt class="col-sm-2">Servings</dt>
    <dd class="col-sm-10">@Model.Recipe.Servings</dd>
</dl>

<form method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
</form>
