@page "{id:int}"
@model MealBuilder.Web.Pages.Recipes.DeleteModel

@{
    ViewData["Title"] = "Delete Recipe";
}

<h1>Delete Recipe</h1>

@if (Model.IsUsed)
{
    <p class="text-danger">
        This recipe cannot be deleted because it is used in recipe components, menus, or prepared batches.
    </p>
}
else
{
    <p class="text-danger">Are you sure you want to delete this recipe?</p>
}

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Recipe.Name</dd>

    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Recipe.Description</dd>

    <dt class="col-sm-2">Total servings</dt>
    <dd class="col-sm-10">@Model.Recipe.TotalServings</dd>
</dl>

<form method="post">
    @if (!Model.IsUsed)
    {
        <button type="submit" class="btn btn-danger">Delete</button>
    }

    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
</form>
