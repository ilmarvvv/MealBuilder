@page
@model MealBuilder.Web.Pages.Recipes.IndexModel

@{
    ViewData["Title"] = "Recipes";
}

<h1>Recipes</h1>

<p>
    <a asp-page="./Create" class="btn btn-primary">Create Recipe</a>
</p>

@if (Model.Recipes.Count == 0)
{
    <p>No recipes have been added yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Servings</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var recipe in Model.Recipes)
            {
                <tr>
                    <td>@recipe.Name</td>
                    <td>@recipe.Description</td>
                    <td>@recipe.Servings</td>
                    <td>
                        <a asp-page="./Details" asp-route-id="@recipe.Id">Details</a> |
                        <a asp-page="./Edit" asp-route-id="@recipe.Id">Edit</a> |
                        <a asp-page="./Delete" asp-route-id="@recipe.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}