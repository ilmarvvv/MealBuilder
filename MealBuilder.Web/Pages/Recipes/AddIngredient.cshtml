@page "{id:int}"
@model MealBuilder.Web.Pages.Recipes.AddIngredientModel

@{
    ViewData["Title"] = "Add Ingredient";
}

<h1>Add Ingredient</h1>

<h2>@Model.Recipe.Name</h2>

<form method="post">
    <input type="hidden" asp-for="RecipeIngredient.RecipeId" />

    <div class="mb-3">
        <label asp-for="RecipeIngredient.IngredientId" class="form-label">Ingredient</label>
        <select asp-for="RecipeIngredient.IngredientId" asp-items="Model.Ingredients" class="form-control">
            <option value="">Select ingredient</option>
        </select>
        <span asp-validation-for="RecipeIngredient.IngredientId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="RecipeIngredient.Grams" class="form-label"></label>
        <input asp-for="RecipeIngredient.Grams" class="form-control" />
        <span asp-validation-for="RecipeIngredient.Grams" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Add</button>
    <a asp-page="./Details" asp-route-id="@Model.Recipe.Id" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
