@page "{id:int}"
@model MealBuilder.Web.Pages.Recipes.DetailsModel

@{
    ViewData["Title"] = "Recipe Details";
}

<h1>Recipe Details</h1>

<dl class="row">
    <dt class="col-sm-4 col-md-3">Name</dt>
    <dd class="col-sm-8 col-md-9">@Model.Recipe.Name</dd>

    <dt class="col-sm-4 col-md-3">Description</dt>
    <dd class="col-sm-8 col-md-9">@Model.Recipe.Description</dd>

    <dt class="col-sm-4 col-md-3">Category</dt>
    <dd class="col-sm-8 col-md-9">Future idea</dd>

    <dt class="col-sm-4 col-md-3">Planned days</dt>
    <dd class="col-sm-8 col-md-9">@Model.Recipe.DefaultPlannedDays</dd>

    <dt class="col-sm-4 col-md-3">Servings per day</dt>
    <dd class="col-sm-8 col-md-9">@Model.Recipe.DefaultServingsPerDay</dd>

    <dt class="col-sm-4 col-md-3">Total servings</dt>
    <dd class="col-sm-8 col-md-9">@Model.Recipe.Servings</dd>

    <dt class="col-sm-4 col-md-3">Prep time minutes</dt>
    <dd class="col-sm-8 col-md-9">@Model.Recipe.PrepTimeMinutes</dd>

    <dt class="col-sm-4 col-md-3">Cook time minutes</dt>
    <dd class="col-sm-8 col-md-9">@Model.Recipe.CookTimeMinutes</dd>

    <dt class="col-sm-4 col-md-3">Recipe weight</dt>
    <dd class="col-sm-8 col-md-9">
        @Model.EffectiveWeightGrams.ToString("0.##") g
        @if (Model.Recipe.FinalWeightGrams is null)
        {
            <span class="text-muted">(estimated)</span>
        }
        else
        {
            <span class="text-muted">(manual)</span>
        }
    </dd>
</dl>

<h2>Nutrition Summary</h2>

<table class="table">
    <thead>
        <tr>
            <th>Type</th>
            <th>Calories</th>
            <th>Protein</th>
            <th>Fiber</th>
            <th>Sugar</th>
            <th>Salt</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>Total recipe</td>
            <td>@Model.Totals.Calories.ToString("0.00")</td>
            <td>@Model.Totals.Protein.ToString("0.00")</td>
            <td>@Model.Totals.Fiber.ToString("0.00")</td>
            <td>@Model.Totals.Sugar.ToString("0.00")</td>
            <td>@Model.Totals.Salt.ToString("0.00")</td>
        </tr>
        <tr>
            <td>Per day</td>
            <td>@Model.PerDayTotals.Calories.ToString("0.00")</td>
            <td>@Model.PerDayTotals.Protein.ToString("0.00")</td>
            <td>@Model.PerDayTotals.Fiber.ToString("0.00")</td>
            <td>@Model.PerDayTotals.Sugar.ToString("0.00")</td>
            <td>@Model.PerDayTotals.Salt.ToString("0.00")</td>
        </tr>
        <tr>
            <td>Per serving</td>
            <td>@Model.PerServingTotals.Calories.ToString("0.00")</td>
            <td>@Model.PerServingTotals.Protein.ToString("0.00")</td>
            <td>@Model.PerServingTotals.Fiber.ToString("0.00")</td>
            <td>@Model.PerServingTotals.Sugar.ToString("0.00")</td>
            <td>@Model.PerServingTotals.Salt.ToString("0.00")</td>
        </tr>
    </tbody>
</table>

<h2>Recipe Contents</h2>

@if (Model.RecipeContentSummaries.Count == 0)
{
    <p>No recipe contents have been added yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Type</th>
                <th>Name</th>
                <th>Grams</th>
                <th>Calories</th>
                <th>Protein</th>
                <th>Fiber</th>
                <th>Sugar</th>
                <th>Salt</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.RecipeContentSummaries)
        {
            <tr>
                <td>@item.Type</td>
                <td>@item.Name</td>
                <td>@item.Grams.ToString("0.##")</td>
                <td>@item.Calories.ToString("0.00")</td>
                <td>@item.Protein.ToString("0.00")</td>
                <td>@item.Fiber.ToString("0.00")</td>
                <td>@item.Sugar.ToString("0.00")</td>
                <td>@item.Salt.ToString("0.00")</td>
                <td>
                    @if (item.Type == "Ingredient")
                    {
                        <a asp-page="./EditIngredient" asp-route-id="@item.Id">Edit</a>

                        <form method="post" asp-page-handler="RemoveIngredient" class="d-inline">
                            <input type="hidden" name="recipeIngredientId" value="@item.Id" />
                            <button type="submit" class="btn btn-link p-0">Remove</button>
                        </form>
                    }
                    else
                    {
                        <a asp-page="./EditComponent" asp-route-id="@item.Id">Edit</a>

                        <form method="post" asp-page-handler="RemoveComponent" class="d-inline">
                            <input type="hidden" name="recipeComponentId" value="@item.Id" />
                            <button type="submit" class="btn btn-link p-0">Remove</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

<p>
    <a asp-page="./AddIngredient" asp-route-id="@Model.Recipe.Id" class="btn btn-primary">Add Ingredient</a>
    <a asp-page="./AddComponent" asp-route-id="@Model.Recipe.Id" class="btn btn-primary">Add Recipe</a>
</p>

<a asp-page="/PreparedRecipeBatches/Create" asp-route-recipeId="@Model.Recipe.Id" class="btn btn-primary">Create Prepared Batch</a>
<a asp-page="./Edit" asp-route-id="@Model.Recipe.Id" class="btn btn-primary">Edit</a>
<a asp-page="./Index" class="btn btn-secondary">Back</a>
