@page "{id:int}"
@model MealBuilder.Web.Pages.Recipes.DetailsModel

@{
    ViewData["Title"] = "Recipe Details";
}

<h1>Recipe Details</h1>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Recipe.Name</dd>

    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Recipe.Description</dd>

    <dt class="col-sm-2">Servings</dt>
    <dd class="col-sm-10">@Model.Recipe.Servings</dd>
</dl>

<h2>Ingredients</h2>

<p>
    <a asp-page="./AddIngredient" asp-route-id="@Model.Recipe.Id" class="btn btn-primary">Add Ingredient</a>
</p>

@if (Model.Recipe.RecipeIngredients.Count == 0)
{
    <p>No ingredients have been added to this recipe yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Ingredient</th>
                <th>Grams</th>
                <th>Calories</th>
                <th>Protein</th>
                <th>Fiber</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var recipeIngredient in Model.Recipe.RecipeIngredients)
            {
                decimal calories = recipeIngredient.Ingredient.CaloriesPer100g * recipeIngredient.Grams / 100;
                decimal protein = recipeIngredient.Ingredient.ProteinPer100g * recipeIngredient.Grams / 100;
                decimal fiber = recipeIngredient.Ingredient.FiberPer100g * recipeIngredient.Grams / 100;

                <tr>
                    <td>@recipeIngredient.Ingredient.Name</td>
                    <td>@recipeIngredient.Grams</td>
                    <td>@calories</td>
                    <td>@protein</td>
                    <td>@fiber</td>
                    <td>
                        <a asp-page="./EditIngredient" asp-route-id="@recipeIngredient.Id">Edit</a>

                        <form method="post" asp-page-handler="RemoveIngredient" class="d-inline">
                            <input type="hidden" name="recipeIngredientId" value="@recipeIngredient.Id" />
                            <button type="submit" class="btn btn-link p-0">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Recipe Components</h2>

<p>
    <a asp-page="./AddComponent" asp-route-id="@Model.Recipe.Id" class="btn btn-primary">Add Recipe Component</a>
</p>

@if (Model.Recipe.Components.Count == 0)
{
    <p>No recipe components have been added to this recipe yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Recipe</th>
                <th>Grams</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var recipeComponent in Model.Recipe.Components)
            {
                <tr>
                    <td>@recipeComponent.ComponentRecipe.Name</td>
                    <td>@recipeComponent.Grams</td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-page="./Edit" asp-route-id="@Model.Recipe.Id" class="btn btn-primary">Edit</a>
<a asp-page="./Index" class="btn btn-secondary">Back</a>
