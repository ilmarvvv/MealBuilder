@page "{id:int}"
@model MealBuilder.Web.Pages.Recipes.DetailsModel

@{
    ViewData["Title"] = "Recipe Details";
}

<h1>Recipe Details</h1>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Recipe.Name</dd>

    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Recipe.Description</dd>

    <dt class="col-sm-2">Servings</dt>
    <dd class="col-sm-10">@Model.Recipe.Servings</dd>
</dl>

<a asp-page="./Edit" asp-route-id="@Model.Recipe.Id" class="btn btn-primary">Edit</a>
<a asp-page="./Index" class="btn btn-secondary">Back</a>
