@page
@model MealBuilder.Web.Pages.DailyPlans.CalendarModel

@{
    ViewData["Title"] = "Daily Plan Calendar";
}

<h1>Daily Plan Calendar</h1>

<p>
    Week: @Model.WeekStart - @Model.WeekStart.AddDays(6)
</p>

<p>
    <a asp-page="./Calendar" asp-route-startDate="@Model.PreviousWeekStartRouteValue" class="btn btn-secondary">Previous Week</a>
    <a asp-page="./Calendar" asp-route-startDate="@Model.NextWeekStartRouteValue" class="btn btn-secondary">Next Week</a>
</p>

<h2>Daily Average</h2>

<table class="table">
    <thead>
        <tr>
            <th>Calories</th>
            <th>Protein</th>
            <th>Fiber</th>
            <th>Sugar</th>
            <th>Salt</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@Model.DailyAverageTotals.Calories.ToString("0.00")</td>
            <td>@Model.DailyAverageTotals.Protein.ToString("0.00")</td>
            <td>@Model.DailyAverageTotals.Fiber.ToString("0.00")</td>
            <td>@Model.DailyAverageTotals.Sugar.ToString("0.00")</td>
            <td>@Model.DailyAverageTotals.Salt.ToString("0.00")</td>
        </tr>
    </tbody>
</table>

<h2>Days</h2>

<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Calories</th>
            <th>Protein</th>
            <th>Fiber</th>
            <th>Sugar</th>
            <th>Salt</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var day in Model.Days)
        {
            <tr>
                <td>
                    @if (day.DailyPlan is null)
                    {
                        <a asp-page="./Details" asp-route-date="@day.Date.ToString("yyyy-MM-dd")">
                            @day.Date
                        </a>
                    }
                    else
                    {
                        <a asp-page="./Details"
                           asp-route-id="@day.DailyPlan.Id">
                            @day.Date
                        </a>
                    }
                </td>
                <td>@day.Totals.Calories.ToString("0.00")</td>
                <td>@day.Totals.Protein.ToString("0.00")</td>
                <td>@day.Totals.Fiber.ToString("0.00")</td>
                <td>@day.Totals.Sugar.ToString("0.00")</td>
                <td>@day.Totals.Salt.ToString("0.00")</td>
            </tr>
        }
    </tbody>
</table>