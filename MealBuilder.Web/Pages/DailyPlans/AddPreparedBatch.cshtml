@page "{id:int}"
@model MealBuilder.Web.Pages.DailyPlans.AddPreparedBatchModel

@{
    ViewData["Title"] = "Add Prepared Batch to Daily Plan";
}

<h1>Add Prepared Batch to Daily Plan</h1>

<h2>@Model.DailyPlan.Name - @Model.DailyPlan.Date</h2>

<form method="post">
    <input type="hidden" asp-for="DailyPlanItem.DailyPlanId" />
    <input type="hidden" asp-for="DailyPlanItem.ItemType" />

    <div class="mb-3">
        <label asp-for="DailyPlanItem.PreparedRecipeBatchId" class="form-label">Prepared Batch</label>
        <select asp-for="DailyPlanItem.PreparedRecipeBatchId" asp-items="Model.PreparedRecipeBatches" class="form-control">
            <option value="">Select prepared batch</option>
        </select>
        <span asp-validation-for="DailyPlanItem.PreparedRecipeBatchId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DailyPlanItem.ServingsCount" class="form-label">Servings</label>
        <input asp-for="DailyPlanItem.ServingsCount" class="form-control" />
        <span asp-validation-for="DailyPlanItem.ServingsCount" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Add</button>
    <a asp-page="./Details" asp-route-id="@Model.DailyPlan.Id" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}