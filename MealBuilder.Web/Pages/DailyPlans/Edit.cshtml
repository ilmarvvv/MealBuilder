@page "{id:int?}"
@model MealBuilder.Web.Pages.DailyPlans.EditModel

@{
    ViewData["Title"] = "Edit Daily Plan";
}

<h1>Edit Daily Plan</h1>

<form method="post">
    <input type="hidden" asp-for="DailyPlan.Id" />

    <div class="mb-3">
        <label asp-for="DailyPlan.Name" class="form-label"></label>
        <input asp-for="DailyPlan.Name" class="form-control" />
        <span asp-validation-for="DailyPlan.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DailyPlan.Date" class="form-label"></label>
        <input asp-for="DailyPlan.Date" class="form-control" type="date" />
        <span asp-validation-for="DailyPlan.Date" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DailyPlan.Description" class="form-label"></label>
        <textarea asp-for="DailyPlan.Description" class="form-control"></textarea>
        <span asp-validation-for="DailyPlan.Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    @if (Model.DailyPlan.Id > 0)
    {
        <a asp-page="./Details"
           asp-route-id="@Model.DailyPlan.Id"
           class="btn btn-secondary">Cancel</a>
    }
    else
    {
        <a asp-page="./Details"
           asp-route-date="@Model.DailyPlan.Date.ToString("yyyy-MM-dd")"
           class="btn btn-secondary">Cancel</a>
    }
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}