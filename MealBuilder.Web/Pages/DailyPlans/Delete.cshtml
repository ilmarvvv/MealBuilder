@page "{id:int}"
@model MealBuilder.Web.Pages.DailyPlans.DeleteModel

@{
    ViewData["Title"] = "Delete Daily Plan";
}

<h1>Delete Daily Plan</h1>

<p class="text-danger">Are you sure you want to delete this dailyPlan?</p>

<dl class="row">
    <dt class="col-sm-3">Date</dt>
    <dd class="col-sm-9">@Model.DailyPlan.Date</dd>

    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.DailyPlan.Name</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.DailyPlan.Description</dd>
</dl>

<form method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="./Details" asp-route-id="@Model.DailyPlan.Id" class="btn btn-secondary">Cancel</a>
</form>