@page
@model MealBuilder.Web.Pages.PreparedRecipeBatches.IndexModel

@{
    ViewData["Title"] = "Prepared Batches";
}

<h1>Prepared Batches</h1>

<p>
    <a asp-page="./Create" class="btn btn-primary">Create Prepared Batch</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Recipe</th>
            <th>Cooked Date</th>
            <th>Total Servings</th>
            <th>Used Servings</th>
            <th>Remaining Servings</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var summary in Model.PreparedRecipeBatchSummaries)
        {
            <tr>
                <td>@summary.PreparedRecipeBatch.Recipe?.Name</td>
                <td>@summary.PreparedRecipeBatch.CookedDate</td>
                <td>@summary.PreparedRecipeBatch.TotalServings</td>
                <td>@summary.UsedServings</td>
                <td>@summary.RemainingServings</td>
            </tr>
        }
    </tbody>
</table>