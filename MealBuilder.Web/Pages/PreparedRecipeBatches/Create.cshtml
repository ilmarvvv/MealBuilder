@page
@model MealBuilder.Web.Pages.PreparedRecipeBatches.CreateModel

@{
    ViewData["Title"] = "Create Prepared Batch";
}

<h1>Create Prepared Batch</h1>

<form method="post">
    <div class="mb-3">
        <label asp-for="PreparedRecipeBatch.RecipeId" class="form-label">Recipe</label>
        <select asp-for="PreparedRecipeBatch.RecipeId" asp-items="Model.RecipeSelectList" class="form-select">
            <option value="">Select recipe</option>
        </select>
        <span asp-validation-for="PreparedRecipeBatch.RecipeId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PreparedRecipeBatch.CookedDate" class="form-label"></label>
        <input asp-for="PreparedRecipeBatch.CookedDate" class="form-control" type="date" />
        <span asp-validation-for="PreparedRecipeBatch.CookedDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PreparedRecipeBatch.PlannedDays" class="form-label"></label>
        <input asp-for="PreparedRecipeBatch.PlannedDays" class="form-control" />
        <span asp-validation-for="PreparedRecipeBatch.PlannedDays" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ServingsPerDay" class="form-label">Servings per day</label>
        <input asp-for="ServingsPerDay" class="form-control" />
        <span asp-validation-for="ServingsPerDay" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Total servings</label>
        <div id="total-servings" class="form-control-plaintext">
            @Model.PreparedRecipeBatch.TotalServings
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const plannedDaysInput =
            document.getElementById("PreparedRecipeBatch_PlannedDays");

        const servingsPerDayInput =
            document.getElementById("ServingsPerDay");

        const totalServingsDisplay =
            document.getElementById("total-servings");

        const recipeSelectInput =
            document.getElementById("PreparedRecipeBatch_RecipeId");

        function updateTotalServings() {
            const plannedDays = Number(plannedDaysInput.value) || 0;
            const servingsPerDay = Number(servingsPerDayInput.value) || 0;

            totalServingsDisplay.textContent =
                plannedDays * servingsPerDay;
        }

        plannedDaysInput.addEventListener("input", updateTotalServings);
        servingsPerDayInput.addEventListener("input", updateTotalServings);

        recipeSelectInput.addEventListener("change", function () {
            if (recipeSelectInput.value) {
                window.location.href =
                    `?recipeId=${recipeSelectInput.value}`;
            }
        });

        updateTotalServings();
    </script>
}