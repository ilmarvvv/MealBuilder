@page "{id:int}"
@model MealBuilder.Web.Pages.PreparedRecipeBatches.DeleteModel

@{
    ViewData["Title"] = "Delete Prepared Batch";
}

<h1>Delete Prepared Batch</h1>

@if (!Model.CanDelete)
{
    <p class="text-danger">
        This prepared batch is already allocated to daily plans and cannot be deleted.
    </p>
}
else
{
    <p class="text-danger">
        Are you sure you want to delete this prepared batch?
    </p>
}

<dl class="row">
    <dt class="col-sm-3">Recipe</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.PreparedRecipeBatch.RecipeNameSnapshot</dd>

    <dt class="col-sm-3">Cooked Date</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.PreparedRecipeBatch.CookedDate</dd>

    <dt class="col-sm-3">Total Servings</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.PreparedRecipeBatch.TotalServings</dd>

    <dt class="col-sm-3">Planned Days</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.PreparedRecipeBatch.PlannedDays</dd>

    <dt class="col-sm-3">Servings Per Day</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.ServingsPerDay.ToString("0.00")</dd>

    <dt class="col-sm-3">Allocated Servings</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.AllocatedServings</dd>

    <dt class="col-sm-3">Unallocated Servings</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.UnallocatedServings</dd>
</dl>

<form method="post">
    @if (Model.CanDelete)
    {
        <button type="submit" class="btn btn-danger">Delete</button>
    }

    <a asp-page="./Details" asp-route-id="@Model.PreparedRecipeBatchSummary.PreparedRecipeBatch.Id" class="btn btn-secondary">Cancel</a>
</form>