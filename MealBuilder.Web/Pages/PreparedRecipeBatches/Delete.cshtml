@page "{id:int}"
@model MealBuilder.Web.Pages.PreparedRecipeBatches.DeleteModel

@{
    ViewData["Title"] = "Delete Prepared Batch";
}

<h1>Delete Prepared Batch</h1>

@if (!Model.CanDelete)
{
    <p class="text-danger">This prepared batch is already used in menus and cannot be deleted.</p>
}
else
{
    <p class="text-danger">Are you sure you want to delete this prepared batch?</p>
}

<dl class="row">
    <dt class="col-sm-3">Recipe</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.PreparedRecipeBatch.Recipe?.Name</dd>

    <dt class="col-sm-3">Cooked Date</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.PreparedRecipeBatch.CookedDate</dd>

    <dt class="col-sm-3">Total Servings</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.PreparedRecipeBatch.TotalServings</dd>

    <dt class="col-sm-3">Used Servings</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.UsedServings</dd>

    <dt class="col-sm-3">Remaining Servings</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.RemainingServings</dd>
</dl>

<form method="post">
    @if (Model.CanDelete)
    {
        <button type="submit" class="btn btn-danger">Delete</button>
    }

    <a asp-page="./Details" asp-route-id="@Model.PreparedRecipeBatchSummary.PreparedRecipeBatch.Id" class="btn btn-secondary">Cancel</a>
</form>