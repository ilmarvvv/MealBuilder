@page "{id:int}"
@model MealBuilder.Web.Pages.PreparedRecipeBatches.DetailsModel

@{
    ViewData["Title"] = "Prepared Batch Details";
}

<h1>Prepared Batch Details</h1>

<dl class="row">
    <dt class="col-sm-3">Recipe</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.PreparedRecipeBatch.RecipeNameSnapshot</dd>

    <dt class="col-sm-3">Cooked Date</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.PreparedRecipeBatch.CookedDate</dd>

    <dt class="col-sm-3">Total Servings</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.PreparedRecipeBatch.TotalServings</dd>

    <dt class="col-sm-3">Planned Days</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.PreparedRecipeBatch.PlannedDays</dd>

    <dt class="col-sm-3">Servings Per Day</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.ServingsPerDay.ToString("0.00")</dd>

    <dt class="col-sm-3">Snapshot Calories</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.PreparedRecipeBatch.TotalCaloriesSnapshot.ToString("0.00")</dd>

    <dt class="col-sm-3">Snapshot Protein</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.PreparedRecipeBatch.TotalProteinSnapshot.ToString("0.00")</dd>

    <dt class="col-sm-3">Snapshot Fiber</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.PreparedRecipeBatch.TotalFiberSnapshot.ToString("0.00")</dd>

    <dt class="col-sm-3">Snapshot Sugar</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.PreparedRecipeBatch.TotalSugarSnapshot.ToString("0.00")</dd>

    <dt class="col-sm-3">Snapshot Salt</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.PreparedRecipeBatch.TotalSaltSnapshot.ToString("0.00")</dd>

    <dt class="col-sm-3">Used Servings</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.UsedServings</dd>

    <dt class="col-sm-3">Remaining Servings</dt>
    <dd class="col-sm-9">@Model.PreparedRecipeBatchSummary.RemainingServings</dd>
</dl>

<a asp-page="./Delete" asp-route-id="@Model.PreparedRecipeBatchSummary.PreparedRecipeBatch.Id" class="btn btn-danger">Delete</a>
<a asp-page="./Index" class="btn btn-secondary">Back</a>