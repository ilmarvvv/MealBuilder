@page "{id:int}"
@model MealBuilder.Web.Pages.PreparedRecipeBatches.EditItemModel

@{
    ViewData["Title"] = "Edit Batch Item";
}

<h1>Edit Batch Item</h1>

<h2>@Model.PreparedRecipeBatchItem.NameSnapshot</h2>

<form method="post">
    <input type="hidden" asp-for="PreparedRecipeBatchItemId" />

    <div class="mb-3">
        <label asp-for="Grams" class="form-label"></label>
        <input asp-for="Grams" class="form-control" />
        <span asp-validation-for="Grams" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="./Edit" asp-route-id="@Model.PreparedRecipeBatchItem.PreparedRecipeBatchId" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}